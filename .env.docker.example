# Copy this file to .env.docker and fill in the secrets:
#
#   cp .env.docker.example .env.docker
#   openssl rand -base64 32      # prefix the output with "base64:"
#
# Then start the stack:
#
#   docker compose --env-file .env.docker up -d --build

APP_NAME="Proto Folio"
APP_ENV=production
APP_DEBUG=false

# Must look like: base64:<32 random bytes in base64>
APP_KEY=

# Public URL and the host binding published by the web container.
# Behind nginx/certbot on the host, keep the app on loopback only.
APP_URL=https://app.yourdomain.com
APP_BIND=127.0.0.1
APP_PORT=8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

DB_DATABASE=profolio
DB_USERNAME=profolio
DB_PASSWORD=change-me

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="Proto Folio"

# Container startup behaviour (handled by docker/entrypoint.sh).
RUN_MIGRATIONS=true
SEED_DEFAULTS=true
APP_OPTIMIZE=true
