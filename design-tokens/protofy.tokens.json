{
  "$name": "Protofy design tokens",
  "$version": "1.0.0",
  "$description": "Shared Protofy core with two presets: Learn (education site) and Desk (product-selling admin app). The CSS files (education.css, admin.css) are the Tailwind v4 implementation; this JSON mirrors them for Figma and other tools.",
  "core": {
    "typography": {
      "sans": "ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
      "display": {
        "education": "ui-rounded, 'SF Pro Rounded', 'Hiragino Maru Gothic ProN', 'Segoe UI Variable Display', ui-sans-serif, system-ui, sans-serif",
        "admin": "ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
      },
      "mono": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace",
      "scale": {
        "ui": "0.875rem",
        "xs": "0.75rem",
        "sm": "0.875rem",
        "base": "1rem",
        "lg": "1.125rem",
        "xl": "1.25rem",
        "2xl": "1.5rem",
        "3xl": "1.875rem",
        "4xl": "2.25rem",
        "5xl": "3rem"
      }
    },
    "spacing": {
      "unit": "0.25rem",
      "scale": {
        "1": "0.25rem",
        "2": "0.5rem",
        "3": "0.75rem",
        "4": "1rem",
        "5": "1.25rem",
        "6": "1.5rem",
        "8": "2rem",
        "10": "2.5rem",
        "12": "3rem",
        "16": "4rem",
        "20": "5rem",
        "24": "6rem"
      }
    },
    "breakpoints": {
      "sm": "40rem",
      "md": "48rem",
      "lg": "64rem",
      "xl": "80rem",
      "2xl": "96rem"
    },
    "zIndex": {
      "base": 0,
      "sticky": 10,
      "dropdown": 20,
      "overlay": 30,
      "modal": 40,
      "toast": 50,
      "skipLink": 60
    },
    "motion": {
      "durationFast": "120ms",
      "durationBase": "180ms",
      "durationSlow": "240ms",
      "easingEducation": "cubic-bezier(0.22, 1, 0.36, 1)",
      "easingAdmin": "cubic-bezier(0.2, 0, 0, 1)"
    },
    "focus": {
      "width": "2px",
      "offset": "3px",
      "offsetAdmin": "2px"
    }
  },
  "themes": {
    "education": {
      "radius": {
        "control": "0.875rem",
        "card": "1.25rem",
        "panel": "1.75rem",
        "pill": "9999px"
      },
      "controlHeights": {
        "sm": "2.75rem",
        "md": "3.25rem",
        "lg": "3.5rem"
      },
      "shadow": {
        "card": "0 1px 2px rgb(19 32 58 / 0.06), 0 14px 34px -14px rgb(19 32 58 / 0.22)",
        "pop": "0 18px 44px -16px rgb(19 32 58 / 0.35)"
      },
      "light": {
        "color": {
          "brand": "#4f46e5",
